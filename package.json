{
  "name": "paperwing",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/paperwingio/paperwing.git"
  },
  "private": true,
  "version": "0.21.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 vite",
    "dev:full": "docker compose up -d --wait && KV_REST_API_URL=${KV_REST_API_URL:-http://localhost:8079} KV_REST_API_TOKEN=${KV_REST_API_TOKEN:-local} CRON_SECRET=${CRON_SECRET:-local} npm run dev",
    "task": "node scripts/task.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/icons.cjs",
    "check:mobile": "node scripts/mobile-check.cjs",
    "publish-feeds": "node scripts/publish-feeds.mjs",
    "logos": "node scripts/logos.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project stories",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "release": "changeset version && node scripts/changelog/generate.mjs && npm install --package-lock-only --ignore-scripts",
    "check:changesets": "node scripts/changelog/check.mjs .changeset/*.md",
    "check:budget": "node scripts/bundle-budget.mjs",
    "check:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "prepare": "[ -n \"$CI\" ] || git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@atproto/oauth-client-browser": "0.5.10",
    "@chenglou/pretext": "^1.0.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@vercel/functions": "3.10.1",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.12.0",
    "idb-keyval": "^6.3.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.61.0",
    "marked": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "undici": "^7.30.1",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fontkit": "^2.0.4",
    "playwright": "^1.63.0",
    "prettier": "3.3.3",
    "simple-icons": "^16.36.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 200
  }
}
